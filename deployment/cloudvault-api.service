[Unit]
Description=CloudVault FastAPI API
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/cloudvault/backend
EnvironmentFile=/etc/cloudvault/backend.env
ExecStart=/opt/cloudvault/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
